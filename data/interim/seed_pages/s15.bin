<!--START POPUP-->

<style>
.popup-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999999;
  overflow-y: auto;
}

.popup-box {
  position: relative;
  background: #fff;
  width: 430px;
  max-width: 92%;
  margin: 80px auto 40px;
  border-radius: 14px;
  text-align: center;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.modal-header1 {
  background: linear-gradient(135deg, #d2232a, #b02027);
  color: white;
  text-align: center;
  padding: 32px 28px 28px;
  position: relative;
}

.modal-title {
  font-size: 1.65rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.3;
}

.close-btn {
  position: absolute;
  top: 14px;
  right: 18px;
  font-size: 26px;
  cursor: pointer;
  font-weight: bold;
  color: white;
  opacity: 0.9;
  line-height: 1;
}
.close-btn:hover {
  opacity: 1;
}

.popup-content {
  padding: 28px 26px 32px;
  font-size: 1.05rem;
  color: #333;
  line-height: 1.55;
}

.job-link {
  display: inline-block;
  margin-top: 18px;
  padding: 11px 26px;
  background: #c22128;
  color: white !important;
  text-decoration: none !important;
  border-radius: 10px;
  font-weight: 600;
  font-size: 1.1rem;
  transition: all 0.25s ease;
}
.job-link:hover {
  background: #a01b20;
  transform: translateY(-1px);
}

@media (max-width: 480px) {
  .popup-box {
    margin-top: 50px;
  }
  .modal-title {
    font-size: 1.4rem;
  }
  .popup-content {
    padding: 22px 18px 28px;
    font-size: 1rem;
  }
}
</style>

<!-- Popup HTML -->
<div id="wpPopup" class="popup-overlay">
  <div class="popup-box">
    <div class="modal-header1">
      <span class="close-btn">✖</span>
      <div class="modal-title">Registration is Now Open!</div>
    </div>
    
    <div class="popup-content">
      <p style="margin: 0 0 12px;">
        B.Tech / MBA Tech Direct II Year Registration is Now Open!
      </p>
      <p style="margin: 0 0 8px;">
        Complete your registration on or before <strong>12.08.2026</strong>.
      </p>
      <a href="https://engineering.nmims.edu/direct-second-year-admission-for-b-tech-mba-tech-batch-2025/" 
         target="_blank" 
         class="job-link">
        Register Now
      </a>
    </div>
  </div>
</div>

