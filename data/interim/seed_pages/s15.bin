<style id="wp-custom-css">
.admin-bar header#site-header{top:30px;}
.programs-details-cards{overflow-x:hidden;display:none;}
.contact-us-form{margin:100px 0;background-color:var(--nims-bg-gray);padding:40px 30px;display:none;}
details summary{padding:10px;cursor:pointer;}
details summary:hover{color:var(--nims-blue);}

.faculty-accordion{margin:0 auto;font-family:'Overpass',sans-serif;}

.facv-item{position:relative;border-bottom:1px solid #e2e2e0;}

/* Hide the radio visually but keep it tappable/focusable — 
   the old rule made it 1px which some mobile browsers 
   effectively treat as untappable/ignorable */
.facv-radio{
  position:absolute;
  opacity:0;
  width:100%;
  height:100%;
  top:0;
  left:0;
  margin:0;
  cursor:pointer;
  z-index:2; /* ensure it sits above the header so taps register */
}

.facv-header{
  position:relative;
  display:flex;
  align-items:center;
  padding:15px 6px;
  cursor:pointer;
  font-weight:700;
  font-size:18px;
  color:#14213d;
  transition:background-color .2s ease;
  -webkit-tap-highlight-color:transparent; /* removes gray flash on tap, but doesn't block the tap */
  touch-action:manipulation; /* prevents 300ms tap delay / double-tap zoom issues on mobile */
}

.facv-header:hover{background-color:#faf9f6;}

.facv-radio:focus-visible + .facv-header{outline:2px solid #a9862f;outline-offset:-2px;}

.facv-icon{
  flex:0 0 auto;
  width:0;height:0;
  margin-right:12px;
  border-style:solid;
  border-width:6px 0 6px 8px;
  border-color:transparent transparent transparent #14213d;
  transition:transform .25s ease;
  pointer-events:none; /* ensures the icon itself never blocks the tap from reaching the label/input */
}

.facv-panel{max-height:0;overflow:hidden;transition:max-height .35s ease;}
.facv-panel-inner{padding:2px 6px 18px 26px;}
.facv-panel-inner ul{margin:0;padding-left:18px;}
.facv-panel-inner li{margin-bottom:10px;font-size:14.5px;line-height:1.6;color:#2c3e63;}
.facv-panel-inner li::marker{color:#a9862f;}

.facv-radio:checked + .facv-header .facv-icon{transform:rotate(90deg);}
.facv-radio:checked ~ .facv-panel{max-height:1200px;}

/* Desktop-only hover expand — untouched, correctly scoped away from touch devices */
@media (hover: hover) and (pointer: fine){
  .facv-item:hover .facv-panel{max-height:1200px;}
  .facv-item:hover .facv-icon{transform:rotate(90deg);}
}

@media (max-width: 480px){
  .facv-header{font-size:15px;padding:13px 4px;}
  .facv-panel-inner{padding:2px 4px 16px 22px;}
  .facv-panel-inner li{font-size:14px;}
}

@media (prefers-reduced-motion: reduce){
  .facv-panel,.facv-icon,.facv-header{transition:none;}
}


.read-more-btn {
    display: inline-block;
    padding: 8px 18px;
    background: #cd2727;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
}
</style>
	
	

	
	
</head>

